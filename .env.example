WHOOP_CLIENT_ID=replace-with-whoop-client-id
WHOOP_CLIENT_SECRET=replace-with-whoop-client-secret
WHOOP_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PI_TIMEZONE=America/Chicago
DASHBOARD_ORIGIN=http://localhost:4001
WHOOP_CACHE_MAX_SECONDS=0
TOKEN_FILE=/var/lib/homelab/whoop/tokens.enc
WEATHER_LATITUDE=replace-with-home-latitude
WEATHER_LONGITUDE=replace-with-home-longitude
WEATHER_LOCATION_LABEL=Home
WEATHER_TEMPERATURE_UNIT=celsius
WEATHER_WIND_SPEED_UNIT=mph